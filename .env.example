# Copy this file to .env in the directory from which you run the program.
# Save as UTF-8. Existing environment variables override these values.
# Single quotes preserve literal $, # and backslashes in connection strings.
# Replace hosts, databases, users and passwords with your own settings.
# Keep .env private; never commit real credentials.

MSSQL_SOURCE_DSN='server=SOURCE_HOST;database=SourceDB;user id=compare_user;password=CHANGE_ME;encrypt=true;TrustServerCertificate=false'
MSSQL_DESTINATION_DSN='server=DESTINATION_HOST;database=DestinationDB;user id=compare_user;password=CHANGE_ME;encrypt=true;TrustServerCertificate=false'

# Windows authentication: omit user id and password to use the current account.
# MSSQL_SOURCE_DSN='server=HOST\INSTANCE;database=SourceDB;encrypt=true;TrustServerCertificate=false'

# Optional migration generation; no SQL is executed automatically.
# Supports SQL procedures/views/functions and synonyms, not table migrations.
# CLR functions are compared, but assembly/function changes require manual migration.
# Creates missing objects, alters changed modules and replaces changed synonyms.
# Destination-only objects are retained; no automatic cleanup/DROP of extras.
# Required destination schemas and compatible table prerequisites must exist.
# Disabled leaves any previously generated SQL file untouched.
MSSQL_GENERATE_MIGRATION=false
MSSQL_MIGRATION_OUT='migration.sql'
#
# Uses catalog dependencies, not alphabetical type order. Dynamic SQL needs review.
# Cycles, unresolved/cross-database references, schema-bound dependents and unsafe
# changes fail generation without replacing the existing migration script.
# Requires SELECT on sys.sql_expression_dependencies in addition to VIEW DEFINITION.
# Run the generated file on the recorded destination database/server, with no
# transaction already open. Review and test on a copy before production use.

# Output format, SQL mode, timeout and output path remain command-line options:
# .\mssql-batch-compare.exe -sql-mode normalized -format html -out diff.html
#
# Track this source database against its last saved schema (destination ignored):
# .\mssql-batch-compare.exe -snapshot -sql-mode normalized -format html
# Requires MSSQL_GENERATE_MIGRATION=false. Saves data/ddmmyyhhmmss/database-id/.
