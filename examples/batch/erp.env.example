# Copy to runs/erp/.env and replace placeholders. Never commit real credentials.
# This example runner clears inherited MSSQL settings in each child process.
MSSQL_SOURCE_DSN='server=SOURCE_HOST;database=ERP_Dev;user id=compare_user;password=CHANGE_ME;encrypt=true;TrustServerCertificate=false'
MSSQL_DESTINATION_DSN='server=DESTINATION_HOST;database=ERP_Prod;user id=compare_user;password=CHANGE_ME;encrypt=true;TrustServerCertificate=false'

# Optional SQL generation only; the runner never executes migration scripts.
# Keep the output relative to this pair's directory to avoid overwriting others.
MSSQL_GENERATE_MIGRATION=false
MSSQL_MIGRATION_OUT='migration.sql'
