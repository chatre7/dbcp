# Copy to runs/crm/.env and replace placeholders. Never commit real credentials.
# This example runner clears inherited MSSQL settings in each child process.
MSSQL_SOURCE_DSN='server=SOURCE_HOST;database=CRM_Dev;user id=compare_user;password=CHANGE_ME;encrypt=true;TrustServerCertificate=false'
MSSQL_DESTINATION_DSN='server=DESTINATION_HOST;database=CRM_Prod;user id=compare_user;password=CHANGE_ME;encrypt=true;TrustServerCertificate=false'

# Optional online SQL generation only; the runner never executes migration scripts.
# Keep the output relative to this pair's directory to avoid overwriting others.
# For -Snapshot -IncludeMigration keep MSSQL_GENERATE_MIGRATION=false.
# It exports source-only catalog metadata to data/ddmmyyhhmmss/database-id/.
# Requires VIEW DEFINITION and SELECT on sys.sql_expression_dependencies.
# Export both isolated sides using their local MSSQL_SOURCE_DSN; transfer only
# JSON securely, not .env. Offline -migration-out explicitly generates SQL.
MSSQL_GENERATE_MIGRATION=false
MSSQL_MIGRATION_OUT='migration.sql'
